rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Control (RBAC)
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'wapp7272@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    // 1. Users collection: /users/{uid}
    match /users/{uid} {
      // Admins can read all users; Customers can only read their own document
      allow read: if isOwner(uid) || isAdmin();

      // Create: Users can initialize their own doc with customer role, or Super Admin
      allow create: if isOwner(uid) && (
        !('role' in request.resource.data) || 
        request.resource.data.role == 'customer' || 
        isSuperAdmin()
      );

      // Update: Users can update profile. Role/bonus flags cannot be modified. Wallet balance can only be debited (decreased) unless Admin.
      allow update: if (isOwner(uid) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'hasClaimedYouTubeBonus', 'hasReceivedBonus']) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['walletBalance']) ||
          request.resource.data.walletBalance <= resource.data.walletBalance
        )
      )) || isAdmin();

      // Delete: Strictly Super Admin
      allow delete: if isSuperAdmin();

      // Customer subcollection orders: /users/{userId}/orders/{orderId}
      match /orders/{orderId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) || isAdmin();
        allow update, delete: if isAdmin();
      }
    }

    // 2. Orders collection (Global Root Orders: /orders/{orderId})
    match /orders/{orderId} {
      // Creation: Customers (authenticated or guest checkout) can create orders,
      // but CANNOT forge privileged orderStatus ('Delivered'/'Shipped')
      allow create: if isAdmin() || (
        request.resource.data.total >= 0 &&
        request.resource.data.subtotal >= 0 &&
        (!('paymentStatus' in request.resource.data) || 
         request.resource.data.paymentStatus == 'Pending' || 
         request.resource.data.paymentStatus == 'Pending Verification' || 
         request.resource.data.paymentStatus == 'Pending (COD on Delivery)' ||
         request.resource.data.paymentStatus == 'Paid (COD on Delivery)' ||
         request.resource.data.paymentStatus == 'Paid' ||
         request.resource.data.paymentStatus == 'Unpaid') &&
        (!('status' in request.resource.data) || 
         request.resource.data.status == 'Pending' || 
         request.resource.data.status == 'Processing' ||
         request.resource.data.status == 'Confirmed') &&
        (!('orderStatus' in request.resource.data) || 
         request.resource.data.orderStatus == 'Pending' || 
         request.resource.data.orderStatus == 'Processing' ||
         request.resource.data.orderStatus == 'Confirmed')
      );

      // Read: Admin can read all orders. Authenticated user can read only their own orders.
      // Unauthenticated guests can fetch an individual order doc by exact ID if tracking
      allow get: if isAdmin() || 
        (isAuthenticated() && resource.data.userId == request.auth.uid) ||
        (resource.data.userId == 'guest');

      // List queries: Admins can list all; authenticated users can list queries constrained to their own userId
      allow list: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);

      // Modification/Deletion: Strictly restricted to Admins. Customers CANNOT tamper with status, payment, or pricing
      allow update, delete: if isAdmin();
    }

    // 3. Products collection (Public read, Admin-only write)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Global Settings & Promo Banners (Public read, Admin-only write)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Sellers / Merchant Stores
    match /sellers/{sellerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Wallet Transactions Ledger (/wallet_transactions/{transactionId})
    match /wallet_transactions/{transactionId} {
      // Owner or Admin can read ledger entries
      allow read: if isAdmin() || (
        isAuthenticated() && resource.data.uid == request.auth.uid
      );

      // Writes restricted strictly to Admins (or trusted server-side execution) to prevent client-side wallet inflation
      allow create, update, delete: if isAdmin();
    }

    // 7. YouTube Bonus Claims & Verification Requests (/youtube_bonus_requests/{claimId})
    match /youtube_bonus_requests/{claimId} {
      // Owner can read their own claim; Admin can read all claims
      allow read: if isAdmin() || (
        isAuthenticated() && resource.data.uid == request.auth.uid
      );

      // Authenticated users can submit their own pending claim
      allow create: if isAuthenticated() && 
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending';

      // Only Admins can approve/reject/modify claims
      allow update, delete: if isAdmin();
    }

  }
}
